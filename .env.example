# Alashi environment variables (copy to .env and fill what you use)

# LLM brain for LLM agents (GLM); without it agents fall back to greedy heuristics.
# Alternative: put the key into ~/.config/alashi/llm.json {"key": "..."}
ALASHI_LLM_KEY=

# RPC endpoint for on-chain runs (bots, indexer); defaults to local validator
ALASHI_RPC=http://127.0.0.1:8899

# Arena party-number persistence (canonical counter across restarts)
# ALASHI_SEQ_FILE=/var/lib/alashi/arena_party_no.txt
ALASHI_SEQ_FILE=

# Agent inbox directory for self-reports (daemon commits them); defaults to <repo>/inbox
ALASHI_INBOX=

# Arena state file for tests (isolates the smoke-run party counter)
ALASHI_STATE_FILE=

# Port for arenad
PORT=8090
