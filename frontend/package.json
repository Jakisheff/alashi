{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:host": "vite --host",
    "check:pose": "node --experimental-strip-types --no-warnings scripts/pose-check.ts",
    "export:poses": "node --experimental-strip-types --no-warnings scripts/export-poses.ts",
    "check:events": "node --experimental-strip-types --no-warnings scripts/events-check.ts",
    "check:graph": "node --experimental-strip-types --no-warnings scripts/graph-check.ts",
    "check:log": "node --experimental-strip-types --no-warnings scripts/log-check.ts",
    "optimize:glb": "node --experimental-strip-types --no-warnings scripts/optimize-glb.ts",
    "companion": "cd companion && tauri dev",
    "companion:build": "cd companion && tauri build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.38",
    "d3": "7.9.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@tauri-apps/cli": "2.12.1",
    "@types/d3": "7.4.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "meshoptimizer": "1.3.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
